# ─── Database (Optional) ────────────────────────────────────────────────────
# Without DATABASE_URL, the app runs in in-memory demo mode (great for local dev).
# Add a Neon / Vercel Postgres / Supabase connection string to enable persistence.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Event-Driven Order System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to "true" to auto-run a demo scenario on first load
NEXT_PUBLIC_AUTO_SEED=false
